<div class="profile">
    <div class="profile__info">
        <div class="profile__info_avatar">
            <img class="profile__info__avatar__img" src="{{avatar}}" alt="Profile Avatar">
        </div>
        <div class="profile__info__details">
            <span>first name:</span>
            <span class="profile__info__details__value">name</span>
        </div>
        <div class="profile__info__details">
            <span>second name:</span>
            <span class="profile__info__details__value">second</span>
        </div>
        <div class="profile__info__details">
            <span>email:</span>
            <span class="profile__info__details__value">email@example.com</span>
        </div>
        <div class="profile__info__details">
            <span>username:</span>
            <span class="profile__info__details__value">username</span>
        </div>
        <div class="profile__info__details">
            <span>phone:</span>
            <span class="profile__info__details__value">+105954512</span>
        </div>
    </div>
    <a href="/edit-profile">Edit Profile</a>
</div>