<main class="profile">
    <div class="profile__info">
        <div class="profile__info_avatar">
            <img class="profile__info__avatar__img" src="{{avatar}}" alt="Profile Avatar">
        </div>
        <div class="profile__info__details">
            <span>first name:</span>
            <span class="profile__info__details__value">{{first_name}}</span>
        </div>
        <div class="profile__info__details">
            <span>second name:</span>
            <span class="profile__info__details__value">{{second_name}}</span>
        </div>
        <div class="profile__info__details">
            <span>email:</span>
            <span class="profile__info__details__value">{{email}}</span>
        </div>
        <div class="profile__info__details">
            <span>username:</span>
            <span class="profile__info__details__value">{{display_name}}</span>
        </div>
        <div class="profile__info__details">
            <span>phone:</span>
            <span class="profile__info__details__value">{{phone}}</span>
        </div>
    </div>
    <a href="/edit-profile">Edit Profile</a>
</main>
