<button class="chat-card{{#if selected}} chat-card--selected{{/if}}" type="button" aria-pressed="{{selected}}">
    <span class="chat-card__avatar">{{#if avatar}}<img class="chat-card__avatar-image" src="{{avatar}}" alt="" crossorigin="use-credentials">{{/if}}</span>
    <span class="chat-card__name">{{name}}</span>
</button>
