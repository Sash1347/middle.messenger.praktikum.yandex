{{#if label}}
    <label for="{{id}}" class="input_field_label">{{label}}</label>
{{/if}}

<input class="input_field" type="{{type}}" id="{{id}}" name="{{name}}" placeholder="{{placeholder}}" value="{{value}}" aria-describedby="{{id}}_error">

<span class="input_field_error" id="{{id}}_error"></span>
