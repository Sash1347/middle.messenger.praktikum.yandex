{
  "name": "messenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "start": "npm run build && vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:eslint && npm run lint:styles && npm run typecheck",
    "lint:eslint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.0"
  },
  "dependencies": {
    "handlebars": "4.7.9",
    "sass": "1.105.0"
  }
}
